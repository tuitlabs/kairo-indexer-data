# Kairo Protocol: Base EVM Ingestion Worker Configuration

DATABASE_URL=postgres://postgres@localhost:5432/kairo_indexer
BASE_WS_URL=wss://sepolia.base.org
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Optional Contract Filter Addresses (lowercase hex)
# KAIRO_MARKET_ADDRESS=0x...
# KAIRO_SETTLEMENT_ADDRESS=0x...
# KAIRO_COALITION_ADDRESS=0x...
# KAIRO_CREDIBILITY_HOOK_ADDRESS=0x...

START_BLOCK=0
MAX_BATCH_SIZE=2000

# Neo4j Graph DB Configuration (AuraDB or local instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# NEO4J_DATABASE=neo4j
